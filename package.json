{
  "name": "gitidor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A columnar markdown editor for static sites that live in GitHub repositories. Tauri v2, for macOS, iPadOS and iOS.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "check": "npm run check:types && npm run test",
    "check:types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "build:macos": "tauri build",
    "ios:init": "tauri ios init && node scripts/patch-ios-plist.mjs && node scripts/patch-ios-linker.mjs",
    "build:ios": "npm run ios:patch && tauri ios build --debug",
    "ios:patch": "node scripts/patch-ios-plist.mjs && node scripts/patch-ios-linker.mjs",
    "ios:dev": "npm run ios:patch && tauri ios dev"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.0",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@fontsource/source-serif-4": "^5.2.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/markdown": "^1.6.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "markdown-it": "^14.1.0",
    "smol-toml": "^1.4.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/markdown-it": "^14.1.0",
    "jsdom": "^31.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
