{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitidor",
  "version": "0.1.0",
  "identifier": "com.laffan.gitidor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run ios:patch"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "gitidor",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "iOS": {
      "minimumSystemVersion": "16.0"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
